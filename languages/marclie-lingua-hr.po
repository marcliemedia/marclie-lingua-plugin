#. Description of the plugin
#: marclie-lingua.php
msgid "Translates a WordPress site into other languages from editable string pairs: the page is translated on the server, each language has its own URLs (/en/, /de/ …), with a language switcher (shortcode and Bricks element) and an optional Marclie Booking integration."
msgstr "Prevodi WordPress web-stranicu na druge jezike iz parova tekstova koje možete uređivati: stranica se prevodi na poslužitelju, svaki jezik ima svoje URL-ove (/en/, /de/ …), uz izbornik jezika (kratki kod i Bricks element) i neobaveznu integraciju s Marclie Bookingom."

#: src/Admin/Page.php:212
msgid "No translated language is set up yet."
msgstr "Još nije postavljen nijedan jezik prijevoda."

#: src/Admin/Page.php:215
msgid "Add a language in the settings."
msgstr "Dodajte jezik u postavkama."

#. translators: 1: source language name, 2: translated language name.
#: src/Admin/Page.php:246
#, php-format
msgid "Each row is one text of the site in %1$s with its %2$s translation; an empty translation shows the %1$s text. Keep the tags such as <strong>…</strong> or <a>…</a> of the text in the translation: they carry the bold text, links and icons."
msgstr "Svaki redak je jedan tekst stranice na jeziku %1$s s prijevodom na jezik %2$s; prazan prijevod prikazuje tekst na jeziku %1$s. Oznake poput <strong>…</strong> ili <a>…</a> iz teksta zadržite i u prijevodu: one nose podebljani tekst, poveznice i ikone."

#: src/Admin/Page.php:281
#: src/Admin/SettingsPage.php:131
msgid "Translated languages"
msgstr "Jezici prijevoda"

#: src/Admin/Page.php:338
msgid "Not saved: the translation must use the same tags as the original text, each closed."
msgstr "Nije spremljeno: prijevod mora imati iste oznake kao izvorni tekst, svaku zatvorenu."

