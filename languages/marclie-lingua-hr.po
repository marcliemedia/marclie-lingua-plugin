#. Description of the plugin
#: marclie-lingua.php
msgid "Translates a WordPress site into other languages from editable string pairs: the page is translated on the server, each language has its own URLs (/en/, /de/ …), with a language switcher (shortcode and Bricks element) and an optional Marclie Booking integration."
msgstr "Prevodi WordPress web-stranicu na druge jezike iz parova tekstova koje možete uređivati: stranica se prevodi na poslužitelju, svaki jezik ima svoje URL-ove (/en/, /de/ …), uz izbornik jezika (kratki kod i Bricks element) i neobaveznu integraciju s Marclie Bookingom."

#: src/Admin/Page.php:175
msgid "No translated language is set up yet."
msgstr "Još nije postavljen nijedan jezik prijevoda."

#: src/Admin/Page.php:177
msgid "Add a language in the settings."
msgstr "Dodajte jezik u postavkama."

#. translators: 1: source language name, 2: translated language name.
#: src/Admin/Page.php:191
#, php-format
msgid "Each row is one text of the site in %1$s with its %2$s translation; an empty translation shows the %1$s text. Keep the tags such as <strong>…</strong> or <a>…</a> of the text in the translation: they carry the bold text, links and icons."
msgstr "Svaki redak je jedan tekst stranice na jeziku %1$s s prijevodom na jezik %2$s; prazan prijevod prikazuje tekst na jeziku %1$s. Oznake poput <strong>…</strong> ili <a>…</a> iz teksta zadržite i u prijevodu: one nose podebljani tekst, poveznice i ikone."

#: src/Admin/Page.php:232
#: src/Admin/SettingsPage.php:108
#: src/Admin/SettingsPage.php:111
msgid "Translated languages"
msgstr "Jezici prijevoda"

#: src/Admin/Page.php:261
msgid "Not saved: the translation must use the same tags as the original text, each closed."
msgstr "Nije spremljeno: prijevod mora imati iste oznake kao izvorni tekst, svaku zatvorenu."

#: src/Admin/SettingsPage.php:29
msgid "Texts"
msgstr "Tekstovi"

#: src/Admin/SettingsPage.php:30
#: src/Admin/SettingsPage.php:87
msgid "Translation settings"
msgstr "Postavke prijevoda"

#: src/Admin/SettingsPage.php:30
msgid "Settings"
msgstr "Postavke"

#: src/Admin/SettingsPage.php:69
msgid "The source language was not changed: confirm that every stored text and translation may be deleted."
msgstr "Izvorni jezik nije promijenjen: potvrdite da se svi spremljeni tekstovi i prijevodi smiju izbrisati."

#: src/Admin/SettingsPage.php:73
msgid "Source language changed; every stored text was deleted. Scan the site to collect the texts again."
msgstr "Izvorni jezik je promijenjen; svi spremljeni tekstovi su izbrisani. Skenirajte stranicu da se tekstovi ponovno prikupe."

#: src/Admin/SettingsPage.php:94
msgid "Source language"
msgstr "Izvorni jezik"

#: src/Admin/SettingsPage.php:101
msgid "The language the content is written in. It is the default language: its pages keep their URLs without a language prefix."
msgstr "Jezik na kojem je sadržaj napisan. To je zadani jezik: njegove stranice zadržavaju URL-ove bez jezičnog prefiksa."

#: src/Admin/SettingsPage.php:103
msgid "Changing it deletes every stored text and translation (they belong to the current source language)."
msgstr "Promjena briše sve spremljene tekstove i prijevode (pripadaju trenutačnom izvornom jeziku)."

#: src/Admin/SettingsPage.php:121
msgid "Position in the language switcher"
msgstr "Položaj u izborniku jezika"

#: src/Admin/SettingsPage.php:126
msgid "Each language gets its URLs under its prefix. The number sets its position in the language switcher."
msgstr "Svaki jezik dobiva URL-ove pod svojim prefiksom. Broj određuje njegov položaj u izborniku jezika."

#: src/Admin/SettingsPage.php:130
msgid "Marclie Booking"
msgstr "Marclie Booking"

#: src/Admin/SettingsPage.php:133
msgid "Marclie Booking integration"
msgstr "Integracija s Marclie Bookingom"

#: src/Admin/SettingsPage.php:136
msgid "Automatic: on when Marclie Booking is active and supports it"
msgstr "Automatski: uključeno kada je Marclie Booking aktivan i podržava integraciju"

#: src/Admin/SettingsPage.php:137
msgid "On"
msgstr "Uključeno"

#: src/Admin/SettingsPage.php:138
msgid "Off: booking widgets are translated like any other text"
msgstr "Isključeno: widgeti za rezervaciju prevode se kao i ostali tekstovi"

#: src/Admin/SettingsPage.php:149
msgid "Search engines"
msgstr "Tražilice"

#: src/Admin/SettingsPage.php:151
msgid "Let search engines index the translated pages (hreflang links, own canonical URL, language sitemaps)"
msgstr "Dopusti tražilicama indeksiranje prevedenih stranica (hreflang poveznice, vlastiti kanonski URL, mape web-stranice po jeziku)"

#: src/Admin/SettingsPage.php:152
msgid "When off, translated pages are \"noindex, follow\"."
msgstr "Kada je isključeno, prevedene stranice su „noindex, follow”."

