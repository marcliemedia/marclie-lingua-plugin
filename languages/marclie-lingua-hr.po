#, php-format
msgid "%s%% translated"
msgstr "%s%% prevedeno"

#. translators: 1: number of pages, 2: language name.
#: src/Admin/Page.php:275
#, php-format
msgid "%1$s %2$s page is hidden from search engines until its texts are translated."
msgid_plural "%1$s %2$s pages are hidden from search engines until their texts are translated."
msgstr[0] "%1$s stranica (%2$s) skrivena je od tražilica dok se njezini tekstovi ne prevedu."
msgstr[1] "%1$s stranice (%2$s) skrivene su od tražilica dok se njihovi tekstovi ne prevedu."
msgstr[2] "%1$s stranica (%2$s) skriveno je od tražilica dok se njihovi tekstovi ne prevedu."

#. translators: %s: number of texts.
#: src/Admin/Page.php:286
#, php-format
msgid "%s untranslated text"
msgid_plural "%s untranslated texts"
msgstr[0] "%s neprevedeni tekst"
msgstr[1] "%s neprevedena teksta"
msgstr[2] "%s neprevedenih tekstova"

#: src/Admin/Page.php:289
msgid "Translate them below (view \"Untranslated\"; for names and codes use the bulk action \"Keep original text\"), then open the page or scan the site to update this list."
msgstr "Prevedite ih u nastavku (prikaz „Nije prevedeno”; za nazive i kodove upotrijebite skupnu radnju „Zadrži izvorni tekst”), a zatim otvorite stranicu ili skenirajte web-stranicu da se popis ažurira."

#: src/Admin/SettingsPage.php:155
msgid "When off, translated pages are \"noindex, follow\". When on, a translated page is still \"noindex, follow\" while it shows texts that are not translated yet (a page in two languages is a poor search result); it is indexed once every text on it is translated."
msgstr "Kada je isključeno, prevedene stranice su „noindex, follow”. Kada je uključeno, prevedena stranica ostaje „noindex, follow” dok prikazuje tekstove koji još nisu prevedeni (stranica na dva jezika loš je rezultat pretraživanja); indeksira se kada su svi njezini tekstovi prevedeni."

#: src/Admin/SettingsPage.php:157
msgid "Version for searchers whose language the site does not have (x-default):"
msgstr "Verzija za korisnike čiji jezik web-stranica nema (x-default):"

#: src/Admin/SettingsPage.php:167
#: src/Admin/SettingsPage.php:170
msgid "Blog posts"
msgstr "Objave na blogu"

#: src/Admin/SettingsPage.php:171
msgid "Translate like the other pages (texts stored and edited here; translated posts can be found in search engines)"
msgstr "Prevodi kao ostale stranice (tekstovi se spremaju i uređuju ovdje; prevedene objave mogu se pronaći u tražilicama)"

#: src/Admin/SettingsPage.php:172
msgid "Translate in the visitor's browser (parts marked data-mlg-skip; nothing to translate here, but translated posts are not indexed)"
msgstr "Prevodi u pregledniku posjetitelja (dijelovi označeni data-mlg-skip; ovdje se ništa ne prevodi, ali prevedene objave se ne indeksiraju)"

#: src/Admin/StringsTable.php:54
